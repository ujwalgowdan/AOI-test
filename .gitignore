data/

# --- Reference screenshots used for bug reports / spec discussion --------
# Keep them out of the repo to avoid pushing huge PNGs. If a specific
# screenshot needs to ship as a doc asset, add it explicitly via -f.
Screenshots/
Screenshot*.png
Screenshot*.PNG
NOT_OK_*.jpg
OK_*.jpg
NOT_DETECTED_*.jpg

# --- Empty placeholder leftover from the move ----------------------------
aoi_system_updated/

# --- Legacy Streamlit reference ------------------------------------------
# archive/legacy-streamlit/ is a working clone of the same repo at the
# pre-rewrite commit (7cf0fd9). It has its own .git/ (so it'd commit as a
# submodule pointer) and a local .env. Both contents and history are still
# reachable on this repo via `git checkout 7cf0fd9`; no need to vendor it.
archive/legacy-streamlit/

# Local backups from scripts/backup-aoi.ps1 (database dumps + capture images).
backups/
