# Copy this file to `.env` and edit. The backend loads it via python-dotenv on
# startup (`backend/legacy/config.py:12`). All keys are optional; defaults fall
# back to the insecure placeholders below and trigger configuration warnings
# on every backend boot.

# --- Admin credentials -------------------------------------------------------
# Bearer-token value for /api/employees and /api/inspectors mutations, and the
# "Send daily report" button in /reports.
# REQUIRED: set a strong value (12+ random characters). There is no default.
# If it is missing, empty, `admin123` or the placeholder below, the backend
# still starts and operators can inspect, but every admin route returns 503
# until a strong value is set. 5 wrong attempts lock sign-in for 60 s.
ADMIN_PASSWORD=change-me-please

# --- Email --- (used by the daily PDF report) --------------------------------
# Gmail requires an App Password — not your account password. See
# https://support.google.com/accounts/answer/185833
SENDER_EMAIL=your.email@example.com
SENDER_PASSWORD=app-password-here

# Comma-separated list of recipient addresses.
RECIPIENT_EMAILS=supervisor@example.com,manager@example.com

# --- Branding (appears on PDF + email headers) -------------------------------
COMPANY_NAME=Innotech Integration
MACHINE_NAME=AOI Tester – M03

# --- Backend data directory --------------------------------------------------
# Where the backend persists captured frames (JPGs) and generated PDFs.
# Operators / inspectors / per-cable test history live in Postgres now;
# only the image files still sit on disk here.
# Default: ./data (resolved relative to the repo root by backend/app/_bootstrap.py).
# AOI_DATA_DIR=C:\path\to\persistent\data

# --- Postgres ---------------------------------------------------------------
# Required. The backend refuses to start without DATABASE_URL.
#
# Local Postgres:
#   DATABASE_URL=postgresql+psycopg://aoi:aoi@localhost:5432/aoi
# docker-compose (matches the `db` service in docker-compose.yml):
#   DATABASE_URL=postgresql+psycopg://aoi:aoi@db:5432/aoi
DATABASE_URL=postgresql+psycopg://aoi:aoi@localhost:5432/aoi

# --- Station token (optional, off by default) --------------------------------
# When AOI_REQUIRE_STATION_TOKEN=1, operator routes (sessions, analyze, peek,
# daily summary, reports, capture images, operator/inspector lists) need an
# `X-Station-Token` header (or `?station_token=` for images and the
# WebSocket) matching AOI_STATION_TOKEN, and PDF report generation also needs
# admin sign-in. Off (0 / unset) = no token anywhere, exactly as before.
# docker-compose passes AOI_STATION_TOKEN to the frontend as VITE_STATION_TOKEN.
# Non-Docker dev: also set VITE_STATION_TOKEN=<same value> for `npm run dev`.
# NOTE: the frontend token ships inside the JS bundle, so anyone who can open
# the UI can read it. It stops scripts and stray LAN clients, not a person.
AOI_REQUIRE_STATION_TOKEN=0
AOI_STATION_TOKEN=

# --- Production stack (docker-compose.prod.yml) -------------------------------
# Only read by the production compose file; the dev stack ignores these.
# POSTGRES_PASSWORD is REQUIRED there (no default; compose refuses to start).
# Use URL-safe characters only (it is embedded in DATABASE_URL), e.g. 32 hex:
#   -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ADMIN_PASSWORD (above) is also required and must be strong in production.
# POSTGRES_PASSWORD=
# Host ports, both bound to 127.0.0.1 only (no LAN exposure). The database is never published.
# AOI_PROD_HTTP_PORT=5174
# AOI_PROD_API_PORT=8011
